# Build trees. Every one of these is reproducible from scripts/build.ps1, and
# build/ alone is 470 MB.
build/

# Snapshot tarballs. These predate this repository and were the only history
# the work had; they are kept on disk but not versioned, because committing a
# tarball of the tree into the tree is history stored twice and diffable
# neither time.
snapshots/

# Captures written by the bench scripts. hw_*.cap are checked in deliberately -
# they are fixtures acceptance.py reads - so only the ad-hoc ones are ignored.
*.cap
!scripts/hw_*.cap

__pycache__/
*.pyc

# The capture core's binary, embedded as a C array for the controller to copy
# into ITCM. Generated by scripts/mkcm7image.py during `build.ps1 -Pair`, and
# its own first line says "do not edit" - so it is build output that happens
# to be a .c file, not source.
firmware/generated/
